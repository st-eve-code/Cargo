# Copy this file to .env, then set the admin password with:
#   npm run admin:password -- "your new password"
# .env is git-ignored. Never store the password itself here.
ADMIN_PASSWORD_HASH=

# Where orders are saved: a plain text file, one order per line. Relative to the project folder.
ORDERS_FILE=data/orders.txt

# API key for the map tiles (Carto). Leave empty to use the provider's default. Keep your real key out of the source code.
NEXT_PUBLIC_MAP_TILE_KEY=

# Vehicle speed on the tracking map: share of the whole route covered per second at full speed.
NEXT_PUBLIC_VEHICLE_SPEED=0.0015

# Company details shown across the website (navbar, footer, contact details, page titles, About and Services text).
# Change any value and restart the dev server. Leave a value empty to use the built-in default.
NEXT_PUBLIC_SITE_NAME=PioneerCargo Solutions
NEXT_PUBLIC_SITE_SHORT_NAME=PioneerCargo
NEXT_PUBLIC_SITE_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_SITE_PHONE=+1 (800) 000-0000
NEXT_PUBLIC_SITE_ADDRESS=Your street address, City, Country
NEXT_PUBLIC_SITE_HOURS=24/7 Global Support
NEXT_PUBLIC_SITE_COPYRIGHT_YEAR=2026

# Public address of the website (used for the sitemap, search results and shared links). Use the real domain when you publish.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social media links in the footer. Replace the placeholders with your real pages. Leave one empty to hide its icon.
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/yourpage
NEXT_PUBLIC_SOCIAL_TELEGRAM=https://t.me/yourchannel
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/yourpage

# Set to true only when the site runs behind a reverse proxy (nginx, Vercel, Cloudflare). It makes the admin login limit use the real client address.
TRUST_PROXY=false

# Number of automatic backups of the orders file to keep (data/backups/). Oldest are deleted first.
ORDERS_BACKUP_KEEP=100


# Email for the contact and quote forms. Messages are sent to NEXT_PUBLIC_SITE_EMAIL.
# Use the SMTP details from your email provider (for example Gmail with an app password, Outlook, Zoho, or your hosting's mail).
# Until these are filled in, the forms show a message asking visitors to email you directly.
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for port 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The sender name and address shown in your inbox, for example: PioneerCargo Website <no-reply@yourdomain.com>
MAIL_FROM=
